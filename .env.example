# Copy to .env for local testing (on Render, set these as Environment
# Variables in the service's Settings tab instead).

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-the-service_role-key-here-NOT-the-anon-key

# The Storage bucket name you create in Supabase (Storage → New bucket).
# Make it PUBLIC so uploaded videos/PDFs/PPTs are viewable in the dashboard.
SUPABASE_STORAGE_BUCKET=content-files

# Any long random string — used to sign admin login tokens.
JWT_SECRET=replace-this-with-a-long-random-string

# Optional — Google Sheets sync (every 30 min, overwrites the sheet with
# the current user list). Leave unset to skip syncing entirely.
# 1. Google Cloud Console → create a service account → create a JSON key.
# 2. Share your target Google Sheet with the service account's email
#    (client_email in the JSON) as an Editor.
# 3. GOOGLE_SHEET_ID is the long ID in the sheet's URL between /d/ and /edit.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE\nKEY\nHERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=paste-the-sheet-id-here
